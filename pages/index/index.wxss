/* 欢迎卡片 */
.hero-card {
  margin: 24rpx 32rpx 28rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
}

.hero-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.hero-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e8f0fe, #d4e4ff);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.hero-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.hero-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1c1c1e;
}

.hero-role {
  font-size: 24rpx;
  color: #007aff;
  font-weight: 500;
  background-color: rgba(0, 122, 255, 0.08);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  align-self: flex-start;
}

.hero-term {
  border-top: 0.5rpx solid rgba(60, 60, 67, 0.12);
  padding-top: 20rpx;
}

.hero-term-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hero-term-label {
  font-size: 28rpx;
}

.hero-term-text {
  font-size: 28rpx;
  color: #1c1c1e;
  flex: 1;
}

.hero-term-arrow {
  font-size: 32rpx;
  color: #007aff;
  font-weight: 300;
}

/* 快捷功能 - 2×2 网格 */
.grid-section {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 32rpx;
  margin-bottom: 28rpx;
}

.grid-card {
  width: calc(50% - 8rpx);
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-sizing: border-box;
}

.grid-icon {
  font-size: 48rpx;
}

.grid-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1c1c1e;
}

/* 公告区 */
.notice-section {
  padding: 0 32rpx;
  margin-bottom: 20rpx;
}

.notice-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
}

.notice-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #8e8e93;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.notice-more {
  font-size: 24rpx;
  color: #007aff;
}

.notice-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 8rpx 28rpx;
}

.notice-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 0.5rpx solid rgba(60, 60, 67, 0.08);
}

.notice-item:last-child {
  border-bottom: none;
}

.notice-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background-color: #007aff;
  flex-shrink: 0;
}

.notice-body {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-width: 0;
}

.notice-text {
  font-size: 28rpx;
  color: #1c1c1e;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-date {
  font-size: 24rpx;
  color: #8e8e93;
  flex-shrink: 0;
}
