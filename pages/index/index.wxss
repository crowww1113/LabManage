/* 顶部欢迎区 */
.header {
  background: linear-gradient(135deg, #007aff 0%, #0056b3 100%);
  padding: 60rpx 40rpx 80rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.header-content {
  display: flex;
  flex-direction: column;
}

.greeting {
  font-size: 40rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.welcome {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 核心金刚区 */
.grid-card {
  margin: -40rpx 24rpx 24rpx;
  position: relative;
  z-index: 1;
}

.grid-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 20rpx 0;
}

.grid-item {
  width: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 0;
}

.grid-icon {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #e8f4fd 0%, #d4edfc 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-bottom: 16rpx;
}

.grid-text {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

/* 近期公告区 */
.notice-card {
  margin: 0 24rpx 24rpx;
  padding: 32rpx;
}

.notice-header {
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.notice-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.notice-list {
  display: flex;
  flex-direction: column;
}

.notice-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.notice-item:last-child {
  border-bottom: none;
}

.notice-dot {
  width: 12rpx;
  height: 12rpx;
  background-color: #007aff;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.notice-content {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-time {
  font-size: 24rpx;
  color: #999999;
  margin-left: 20rpx;
  flex-shrink: 0;
}
