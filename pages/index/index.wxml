<!-- 欢迎卡片 -->
<view class="hero-card">
  <view class="hero-row">
    <view class="hero-avatar">👤</view>
    <view class="hero-info">
      <text class="hero-name">{{realName || username}}</text>
      <text class="hero-role">{{roleName}}</text>
    </view>
  </view>
  <view class="hero-term" wx:if="{{terms.length > 0}}">
    <picker mode="selector" range="{{terms}}" range-key="termName" value="{{termIndex}}" bindchange="onTermChange">
      <view class="hero-term-row">
        <text class="hero-term-label">📅</text>
        <text class="hero-term-text">{{terms[termIndex].termName}}</text>
        <text class="hero-term-arrow">›</text>
      </view>
    </picker>
  </view>
</view>

<!-- 快捷功能 - 2×2 网格 -->
<view class="grid-section">
  <view class="grid-card" bindtap="onTapGrid" data-type="lab">
    <text class="grid-icon">🔬</text>
    <text class="grid-label">实验室预约</text>
  </view>
  <view class="grid-card" bindtap="onTapGrid" data-type="equipment">
    <text class="grid-icon">🔧</text>
    <text class="grid-label">设备借用</text>
  </view>
  <view class="grid-card" bindtap="onTapGrid" data-type="course">
    <text class="grid-icon">📚</text>
    <text class="grid-label">我的课程</text>
  </view>
  <view class="grid-card" bindtap="onTapGrid" data-type="message">
    <text class="grid-icon">📢</text>
    <text class="grid-label">消息通知</text>
  </view>
</view>

<!-- 近期公告 -->
<view class="notice-section">
  <view class="notice-header">
    <text class="notice-title">近期公告</text>
    <text class="notice-more">查看全部 ›</text>
  </view>
  <view class="notice-card">
    <view class="notice-item">
      <view class="notice-dot"></view>
      <view class="notice-body">
        <text class="notice-text">关于实验室安全检查的通知</text>
        <text class="notice-date">06-10</text>
      </view>
    </view>
    <view class="notice-item">
      <view class="notice-dot"></view>
      <view class="notice-body">
        <text class="notice-text">2026年暑假实验室开放时间安排</text>
        <text class="notice-date">06-08</text>
      </view>
    </view>
    <view class="notice-item">
      <view class="notice-dot"></view>
      <view class="notice-body">
        <text class="notice-text">新增实验室设备预约功能上线</text>
        <text class="notice-date">06-05</text>
      </view>
    </view>
  </view>
</view>

<!-- 底部安全距离 -->
<view style="height: 160rpx"></view>
