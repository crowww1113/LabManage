<view class="login-container">
  <!-- 标题区 -->
  <view class="login-header">
    <text class="login-title">实验室预约</text>
    <text class="login-subtitle">登录您的账号</text>
  </view>

  <!-- 表单 -->
  <view class="login-form">
    <view class="input-group">
      <input
        class="form-input"
        placeholder="学号 / 工号"
        value="{{username}}"
        bindinput="onUsernameInput"
      />
    </view>
    <view class="input-group">
      <input
        class="form-input"
        placeholder="密码"
        password
        value="{{password}}"
        bindinput="onPasswordInput"
      />
    </view>

    <button class="btn-primary login-btn" bindtap="handleLogin">登录</button>
  </view>

  <!-- 演示账号 -->
  <view class="demo-section">
    <text class="demo-hint">演示账号（点击填充）</text>
    <view class="demo-list">
      <view class="demo-item" bindtap="fillDemo" data-username="admin" data-password="admin123">
        <text class="demo-role">管理员</text>
        <text class="demo-account">admin / admin123</text>
      </view>
      <view class="demo-divider"></view>
      <view class="demo-item" bindtap="fillDemo" data-username="teacher_liu" data-password="teacher123">
        <text class="demo-role">教师</text>
        <text class="demo-account">teacher_liu / teacher123</text>
      </view>
      <view class="demo-divider"></view>
      <view class="demo-item" bindtap="fillDemo" data-username="stu_chen" data-password="student123">
        <text class="demo-role">学生</text>
        <text class="demo-account">stu_chen / student123</text>
      </view>
    </view>
  </view>

  <!-- 底部 -->
  <view class="login-footer">
    <text class="footer-text">登录即表示您同意相关服务条款</text>
  </view>
</view>
