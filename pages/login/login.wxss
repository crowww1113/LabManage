.login-container {
  min-height: 100vh;
  padding: 0 48rpx;
  background: linear-gradient(180deg, rgba(0,122,255,0.04) 0%, #ffffff 30%);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* 标题 */
.login-header {
  margin-bottom: 80rpx;
}

.login-title {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: #1c1c1e;
  letter-spacing: -1rpx;
  margin-bottom: 12rpx;
}

.login-subtitle {
  display: block;
  font-size: 30rpx;
  color: #8e8e93;
}

/* 表单 */
.login-form {
  margin-bottom: 64rpx;
}

.input-group {
  margin-bottom: 24rpx;
}

.form-input {
  width: 100%;
  height: 100rpx;
  padding: 0 32rpx;
  border: none;
  border-bottom: 0.5rpx solid rgba(60, 60, 67, 0.12);
  font-size: 32rpx;
  color: #1c1c1e;
  background-color: transparent;
  box-sizing: border-box;
}

.form-input:focus {
  border-bottom-color: #007aff;
}

.login-btn {
  margin-top: 48rpx;
}

/* 演示账号 */
.demo-section {
  margin-bottom: 64rpx;
}

.demo-hint {
  display: block;
  font-size: 24rpx;
  color: #8e8e93;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}

.demo-list {
  background-color: #f2f2f7;
  border-radius: 20rpx;
  padding: 4rpx 0;
}

.demo-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
}

.demo-divider {
  height: 0.5rpx;
  background-color: rgba(60, 60, 67, 0.12);
  margin-left: 32rpx;
}

.demo-role {
  font-size: 28rpx;
  color: #1c1c1e;
  font-weight: 500;
}

.demo-account {
  font-size: 26rpx;
  color: #8e8e93;
}

/* 底部 */
.login-footer {
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: #c7c7cc;
}
