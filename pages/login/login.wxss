.login-container {
  min-height: 100vh;
  padding: 0 40rpx 60rpx;
  background: linear-gradient(180deg, #007aff 0%, #f5f6f8 40%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 顶部标题区域 */
.login-header {
  padding-top: 160rpx;
  padding-bottom: 80rpx;
  text-align: center;
  width: 100%;
}

.login-title {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 16rpx;
}

.login-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 登录卡片 */
.login-card {
  width: 100%;
  padding: 48rpx 40rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
}

/* 表单项 */
.form-group {
  margin-bottom: 36rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333333;
  background-color: #f8f9fa;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #007aff;
  background-color: #ffffff;
}

/* 登录按钮 */
.login-btn {
  margin-top: 48rpx;
}

/* 演示账号卡片 */
.demo-card {
  width: 100%;
  margin-top: 24rpx;
  padding: 32rpx 40rpx;
  box-sizing: border-box;
}

.demo-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.demo-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.demo-tip {
  font-size: 24rpx;
  color: #999999;
}

.demo-list {
  display: flex;
  flex-direction: column;
}

.demo-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.demo-item:last-child {
  margin-bottom: 0;
}

.demo-role {
  font-size: 26rpx;
  color: #007aff;
  font-weight: 500;
}

.demo-account {
  font-size: 26rpx;
  color: #666666;
}

/* 底部提示 */
.login-footer {
  margin-top: 60rpx;
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: #999999;
}
