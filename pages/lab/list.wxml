<!-- pages/lab/list.wxml -->
<view class="page-container">
  <!-- 非学生角色：即将上线 -->
  <view wx:if="{{!isStudent}}" class="page-empty">
    <text class="page-empty-icon">🔬</text>
    <text class="page-empty-title">实验室预约</text>
    <text class="page-empty-desc">即将上线</text>
  </view>

  <!-- 学生角色：正常功能 -->
  <block wx:else>
    <!-- 搜索栏 -->
    <view class="search-section">
      <view class="search-bar">
        <text class="search-icon">🔍</text>
        <input
          class="search-input"
          placeholder="搜索实验室"
          value="{{searchText}}"
          bindinput="onSearchInput"
          confirm-type="search"
        />
        <text
          wx:if="{{searchText}}"
          class="search-clear"
          bindtap="onSearchClear"
        >✕</text>
      </view>
    </view>

    <!-- 筛选条件 -->
    <view class="filter-section">
      <view class="filter-row">
        <picker mode="selector" range="{{terms}}" range-key="termName" value="{{termIndex}}" bindchange="onTermChange">
          <view class="filter-picker">
            <text class="filter-picker-text">{{terms[termIndex].termName || '学期'}}</text>
            <text class="filter-chevron">‹</text>
          </view>
        </picker>
        <view class="filter-divider"></view>
        <picker mode="selector" range="{{buildings}}" range-key="name" value="{{buildingIndex}}" bindchange="onBuildingChange">
          <view class="filter-picker">
            <text class="filter-picker-text">{{buildings[buildingIndex].name || '楼栋'}}</text>
            <text class="filter-chevron">‹</text>
          </view>
        </picker>
      </view>
      <view class="filter-row">
        <picker mode="selector" range="{{weeks}}" value="{{weekIndex}}" bindchange="onWeekChange">
          <view class="filter-picker">
            <text class="filter-picker-text">第 {{weeks[weekIndex]}} 周</text>
            <text class="filter-chevron">‹</text>
          </view>
        </picker>
        <view class="filter-divider"></view>
        <picker mode="selector" range="{{days}}" value="{{dayIndex}}" bindchange="onDayChange">
          <view class="filter-picker">
            <text class="filter-picker-text">{{days[dayIndex]}}</text>
            <text class="filter-chevron">‹</text>
          </view>
        </picker>
      </view>
    </view>

    <!-- 状态筛选 -->
    <view class="segment-bar">
      <view
        class="segment-item {{filterType === 'all' ? 'active' : ''}}"
        data-type="all"
        bindtap="onFilterChange"
      >全部</view>
      <view
        class="segment-item {{filterType === 'free' ? 'active' : ''}}"
        data-type="free"
        bindtap="onFilterChange"
      >空闲</view>
      <view
        class="segment-item {{filterType === 'busy' ? 'active' : ''}}"
        data-type="busy"
        bindtap="onFilterChange"
      >占用</view>
    </view>

    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="loading">
      <view class="loading-spinner"></view>
    </view>

    <!-- 列表 -->
    <view wx:elif="{{filteredList.length > 0}}" class="lab-list">
      <view
        wx:for="{{filteredList}}"
        wx:key="id"
        class="lab-card"
        data-id="{{item.id}}"
        bindtap="onLabTap"
      >
        <view class="lab-top">
          <view class="lab-name-row">
            <text class="lab-name">{{item.code}}</text>
            <text class="lab-type">{{item.roomType}}</text>
          </view>
          <view class="lab-status {{item.isAvailable ? 'free' : 'busy'}}">
            {{item.isAvailable ? '空闲' : '占用'}}
          </view>
        </view>

        <view class="lab-meta">
          <text class="lab-meta-text">🪑 {{item.seats}}人</text>
          <text wx:if="{{!item.isAvailable}}" class="lab-meta-text">📚 {{item.conflicts.length}}门课程</text>
        </view>

        <view wx:if="{{!item.isAvailable && item.conflicts.length > 0}}" class="lab-conflicts">
          <view wx:for="{{item.conflicts}}" wx:key="courseName" wx:for-item="conflict" class="conflict-row">
            <text class="conflict-time">{{conflict.timeSlotName}}</text>
            <text class="conflict-course">{{conflict.courseName}}</text>
            <text class="conflict-teacher">{{conflict.teacherName}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:else class="empty">
      <text class="empty-text">暂无数据</text>
    </view>
  </block>

  <!-- 底部安全距离 -->
  <view style="height: 160rpx"></view>
</view>
