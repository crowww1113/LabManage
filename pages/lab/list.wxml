<!-- pages/lab/list.wxml -->
<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <text class="search-icon-text">🔍</text>
      <input
        class="search-input"
        placeholder="搜索实验室名称"
        value="{{searchText}}"
        bindinput="onSearchInput"
        confirm-type="search"
      />
      <text
        wx:if="{{searchText}}"
        class="clear-icon-text"
        bindtap="onSearchClear"
      >✕</text>
    </view>
  </view>

  <!-- 筛选条件区 -->
  <view class="filter-section">
    <!-- 第一行：学期 + 楼栋 -->
    <view class="filter-row">
      <picker mode="selector" range="{{terms}}" range-key="termName" value="{{termIndex}}" bindchange="onTermChange">
        <view class="picker-content">
          <text class="picker-text">{{terms[termIndex].termName || '选择学期'}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>

      <picker mode="selector" range="{{buildings}}" range-key="name" value="{{buildingIndex}}" bindchange="onBuildingChange">
        <view class="picker-content">
          <text class="picker-text">{{buildings[buildingIndex].name || '选择楼栋'}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>

    <!-- 第二行：周次 + 星期 -->
    <view class="filter-row">
      <picker mode="selector" range="{{weeks}}" value="{{weekIndex}}" bindchange="onWeekChange">
        <view class="picker-content">
          <text class="picker-text">第 {{weeks[weekIndex]}} 周</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>

      <picker mode="selector" range="{{days}}" value="{{dayIndex}}" bindchange="onDayChange">
        <view class="picker-content">
          <text class="picker-text">{{days[dayIndex]}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>
  </view>

  <!-- 筛选标签 -->
  <view class="filter-tabs">
    <view
      class="filter-tab {{filterType === 'all' ? 'active' : ''}}"
      data-type="all"
      bindtap="onFilterChange"
    >
      全部
    </view>
    <view
      class="filter-tab {{filterType === 'free' ? 'active' : ''}}"
      data-type="free"
      bindtap="onFilterChange"
    >
      空闲
    </view>
    <view
      class="filter-tab {{filterType === 'busy' ? 'active' : ''}}"
      data-type="busy"
      bindtap="onFilterChange"
    >
      占用
    </view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 列表 -->
  <view wx:elif="{{filteredList.length > 0}}" class="lab-list">
    <view
      wx:for="{{filteredList}}"
      wx:key="id"
      class="lab-card"
      data-id="{{item.id}}"
      bindtap="onLabTap"
    >
      <view class="lab-header">
        <view class="lab-name-wrap">
          <text class="lab-name">{{item.code}}</text>
          <text class="lab-type">{{item.roomType}}</text>
        </view>
        <view class="status-badge {{item.isAvailable ? 'free' : 'busy'}}">
          {{item.isAvailable ? '空闲' : '占用'}}
        </view>
      </view>

      <view class="lab-info">
        <view class="info-item">
          <text class="info-icon-text">🪑</text>
          <text class="info-text">容纳 {{item.seats}} 人</text>
        </view>
        <view class="info-item" wx:if="{{!item.isAvailable}}">
          <text class="info-icon-text">📚</text>
          <text class="info-text">{{item.conflicts.length}} 门课程</text>
        </view>
      </view>

      <view wx:if="{{!item.isAvailable && item.conflicts.length > 0}}" class="lab-conflicts">
        <view wx:for="{{item.conflicts}}" wx:key="courseName" wx:for-item="conflict" class="conflict-item">
          <text class="conflict-time">{{conflict.timeSlotName}}</text>
          <text class="conflict-course">{{conflict.courseName}}</text>
          <text class="conflict-teacher">{{conflict.teacherName}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:else class="empty">
    <image class="empty-icon" src="/images/empty.png" mode="aspectFit"></image>
    <text class="empty-text">暂无实验室数据</text>
  </view>
</view>
