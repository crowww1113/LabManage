/* pages/lab/list.wxss */

.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 20rpx;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx 24rpx;
  background-color: #fff;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
}

.search-icon-text {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 40rpx;
}

.clear-icon-text {
  font-size: 32rpx;
  margin-left: 16rpx;
  color: #999;
}

/* 筛选条件区 */
.filter-section {
  padding: 16rpx 24rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
}

.filter-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.filter-row:last-child {
  margin-bottom: 0;
}

.picker-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 1;
  background-color: #f0f7ff;
  border: 2rpx solid #007aff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.picker-text {
  font-size: 26rpx;
  color: #007aff;
  font-weight: 500;
}

.picker-arrow {
  font-size: 20rpx;
  color: #007aff;
}

/* 筛选标签 */
.filter-tabs {
  display: flex;
  padding: 20rpx 24rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
  gap: 24rpx;
}

.filter-tab {
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  color: #666;
  background-color: #f5f5f5;
  border-radius: 32rpx;
  transition: all 0.3s;
}

.filter-tab.active {
  color: #fff;
  background-color: #007aff;
}

/* 加载状态 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #007aff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #999;
}

/* 实验室列表 */
.lab-list {
  padding: 20rpx 24rpx;
}

.lab-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.lab-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.lab-name-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.lab-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.lab-type {
  font-size: 22rpx;
  color: #007aff;
  background-color: #f0f7ff;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-badge.free {
  background-color: #e6f7e6;
  color: #52c41a;
}

.status-badge.busy {
  background-color: #fff2e6;
  color: #fa8c16;
}

.lab-info {
  display: flex;
  gap: 32rpx;
  margin-bottom: 16rpx;
}

.info-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.info-icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.6;
}

.info-text {
  font-size: 26rpx;
  color: #666;
}

/* 预约冲突列表 */
.lab-conflicts {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 16rpx;
}

.conflict-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 0;
}

.conflict-time {
  font-size: 24rpx;
  color: #007aff;
  background-color: #f0f7ff;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.conflict-course {
  font-size: 24rpx;
  color: #333;
  flex: 1;
}

.conflict-teacher {
  font-size: 22rpx;
  color: #999;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
