/* pages/lab/list.wxss */

.page-container {
  min-height: 100vh;
  background-color: #f2f2f7;
}

/* 搜索栏 - 微妙渐变 */
.search-section {
  padding: 24rpx 32rpx 20rpx;
  background: linear-gradient(180deg, rgba(0,122,255,0.03) 0%, transparent 100%);
}

.search-bar {
  display: flex;
  align-items: center;
  background-color: rgba(118,118,128,0.12);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 40rpx;
  color: #1c1c1e;
}

.search-clear {
  font-size: 28rpx;
  color: #8e8e93;
  padding: 8rpx;
  margin-left: 12rpx;
}

/* 筛选条件 */
.filter-section {
  background-color: #ffffff;
  border-radius: 20rpx;
  margin: 0 32rpx 20rpx;
  overflow: hidden;
}

.filter-row {
  display: flex;
  align-items: center;
}

.filter-row:first-child {
  border-bottom: 0.5rpx solid rgba(60, 60, 67, 0.12);
}

.filter-picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}

.filter-picker-text {
  font-size: 28rpx;
  color: #1c1c1e;
}

.filter-chevron {
  font-size: 32rpx;
  color: #007aff;
  transform: rotate(180deg);
  font-weight: 300;
}

.filter-divider {
  width: 0.5rpx;
  height: 40rpx;
  background-color: rgba(60, 60, 67, 0.12);
}

/* 分段控件 - 蓝色强调 */
.segment-bar {
  display: flex;
  margin: 0 32rpx 20rpx;
  background-color: rgba(0, 122, 255, 0.08);
  border-radius: 14rpx;
  padding: 4rpx;
}

.segment-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #1c1c1e;
  border-radius: 12rpx;
  font-weight: 500;
  transition: all 0.2s;
}

.segment-item.active {
  background-color: #ffffff;
  color: #007aff;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 加载状态 */
.loading {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e5e5ea;
  border-top: 4rpx solid #007aff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 实验室列表 */
.lab-list {
  padding: 0 32rpx;
}

.lab-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
}

.lab-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.lab-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.lab-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.lab-type {
  font-size: 22rpx;
  color: #007aff;
  background-color: rgba(0, 122, 255, 0.08);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.lab-status {
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 12rpx;
}

.lab-status.free {
  color: #34c759;
  background-color: rgba(52, 199, 89, 0.12);
}

.lab-status.busy {
  color: #ff9500;
  background-color: rgba(255, 149, 0, 0.12);
}

.lab-meta {
  display: flex;
  gap: 32rpx;
  margin-bottom: 8rpx;
}

.lab-meta-text {
  font-size: 26rpx;
  color: #8e8e93;
}

/* 冲突列表 */
.lab-conflicts {
  border-top: 0.5rpx solid rgba(60, 60, 67, 0.12);
  margin-top: 12rpx;
  padding-top: 12rpx;
}

.conflict-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 0;
}

.conflict-time {
  font-size: 24rpx;
  color: #007aff;
  font-weight: 500;
  flex-shrink: 0;
}

.conflict-course {
  font-size: 24rpx;
  color: #1c1c1e;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.conflict-teacher {
  font-size: 22rpx;
  color: #8e8e93;
  flex-shrink: 0;
}

/* 空状态 */
.empty {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #8e8e93;
}

/* 非学生角色占位 */
.page-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 80vh;
}

.page-empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.page-empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1c1c1e;
  margin-bottom: 12rpx;
}

.page-empty-desc {
  font-size: 28rpx;
  color: #8e8e93;
}
