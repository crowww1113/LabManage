/* pages/lab/detail.wxss */

.detail-page {
  min-height: 100vh;
  background-color: #f2f2f7;
}

/* 加载状态 */
.loading {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e5e5ea;
  border-top: 4rpx solid #8e8e93;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.detail-content {
  padding-bottom: 40rpx;
}

/* 通用 section */
.section {
  padding: 0 32rpx;
  margin-bottom: 12rpx;
}

.section-title {
  font-size: 24rpx;
  font-weight: 500;
  color: #8e8e93;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  padding: 0 4rpx 12rpx;
  display: block;
}

/* 信息卡片 */
.info-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-top: 16rpx;
}

.info-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.info-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.info-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1c1c1e;
}

.info-tag {
  font-size: 22rpx;
  color: #8e8e93;
  background-color: #f2f2f7;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.book-btn {
  background-color: #007aff;
  color: #ffffff;
  padding: 14rpx 40rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.info-stats {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-top: 0.5rpx solid rgba(60, 60, 67, 0.12);
  border-bottom: 0.5rpx solid rgba(60, 60, 67, 0.12);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #007aff;
}

.stat-label {
  font-size: 24rpx;
  color: #8e8e93;
}

.stat-divider {
  width: 0.5rpx;
  height: 48rpx;
  background-color: rgba(60, 60, 67, 0.12);
}

.intro-row {
  padding-top: 20rpx;
}

.intro-text {
  font-size: 26rpx;
  color: #8e8e93;
  line-height: 1.6;
}

/* 选择器行 */
.picker-row {
  display: flex;
  align-items: center;
}

.picker-sep {
  width: 0.5rpx;
  height: 40rpx;
  background-color: rgba(60, 60, 67, 0.12);
}

.detail-picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 24rpx;
}

.detail-picker-text {
  font-size: 28rpx;
  color: #1c1c1e;
}

.detail-chevron {
  font-size: 32rpx;
  color: #007aff;
  transform: rotate(180deg);
  font-weight: 300;
}

/* 星期选择 - 蓝色强调 */
.day-bar {
  display: flex;
  margin: 0 32rpx 20rpx;
  background-color: rgba(0, 122, 255, 0.08);
  border-radius: 14rpx;
  padding: 4rpx;
}

.day-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #1c1c1e;
  border-radius: 12rpx;
  font-weight: 500;
}

.day-item.active {
  background-color: #ffffff;
  color: #007aff;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 时段列表 */
.slot-item {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 0.5rpx solid rgba(60, 60, 67, 0.12);
}

.slot-item:last-child {
  border-bottom: none;
}

.slot-left {
  min-width: 140rpx;
}

.slot-time {
  font-size: 26rpx;
  color: #007aff;
  font-weight: 500;
}

.slot-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.slot-course {
  font-size: 28rpx;
  color: #1c1c1e;
  font-weight: 500;
}

.slot-detail {
  font-size: 24rpx;
  color: #8e8e93;
}

/* 空状态 */
.empty-slot {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #8e8e93;
}

/* ========== 预约弹窗 ========== */
.booking-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.booking-sheet {
  width: 100%;
  background-color: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  max-height: 85vh;
  overflow-y: auto;
}

.booking-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 0.5rpx solid rgba(60, 60, 67, 0.12);
}

.booking-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.booking-close {
  font-size: 32rpx;
  color: #8e8e93;
  padding: 8rpx;
}

.booking-form {
  padding: 16rpx 32rpx 0;
}

.booking-field {
  padding: 24rpx 0;
  border-bottom: 0.5rpx solid rgba(60, 60, 67, 0.08);
}

.booking-field:last-child {
  border-bottom: none;
}

.booking-label {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: #8e8e93;
  margin-bottom: 14rpx;
}

.booking-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background-color: #f2f2f7;
  border-radius: 14rpx;
}

.booking-picker-text {
  font-size: 28rpx;
  color: #1c1c1e;
}

.booking-picker-arrow {
  font-size: 32rpx;
  color: #007aff;
  font-weight: 300;
}

.booking-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background-color: #f2f2f7;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #1c1c1e;
  box-sizing: border-box;
}

.booking-textarea {
  width: 100%;
  height: 160rpx;
  padding: 20rpx 24rpx;
  background-color: #f2f2f7;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #1c1c1e;
  box-sizing: border-box;
  line-height: 1.5;
}

.booking-footer {
  padding: 24rpx 32rpx 32rpx;
}

.booking-submit {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background-color: #007aff;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  border-radius: 20rpx;
  border: none;
  letter-spacing: 2rpx;
}

.booking-submit::after {
  border: none;
}

.booking-submit.disabled {
  opacity: 0.5;
}
