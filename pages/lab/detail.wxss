/* pages/lab/detail.wxss */

.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 加载状态 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #007aff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #999;
}

.detail-content {
  padding: 24rpx;
}

/* 信息卡片 */
.info-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.lab-title-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.lab-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
}

.lab-type-tag {
  font-size: 24rpx;
  color: #007aff;
  background-color: #f0f7ff;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.book-btn {
  background-color: #007aff;
  color: #fff;
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.info-grid {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.info-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #007aff;
}

.info-label {
  font-size: 24rpx;
  color: #999;
}

.intro-section {
  padding-top: 24rpx;
}

.intro-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

.intro-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 周次选择器 */
.week-selector {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.selector-row {
  display: flex;
  gap: 16rpx;
}

.picker-content {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background-color: #fff;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  border: 2rpx solid #007aff;
  flex: 1;
  justify-content: center;
}

.picker-text {
  font-size: 26rpx;
  color: #007aff;
}

.picker-arrow {
  font-size: 20rpx;
  color: #007aff;
}

/* 星期标签 */
.day-tabs {
  display: flex;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.day-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #666;
  border-radius: 8rpx;
  transition: all 0.3s;
}

.day-tab.active {
  background-color: #007aff;
  color: #fff;
  font-weight: 500;
}

/* 预约情况 */
.availability-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.conflict-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.conflict-item {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background-color: #fff8e6;
  border-radius: 12rpx;
  border-left: 6rpx solid #fa8c16;
}

.conflict-time {
  font-size: 26rpx;
  font-weight: 500;
  color: #fa8c16;
  min-width: 120rpx;
}

.conflict-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.conflict-course {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.conflict-teacher {
  font-size: 24rpx;
  color: #666;
}

.conflict-clazz {
  font-size: 22rpx;
  color: #999;
}

.empty-slot {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
