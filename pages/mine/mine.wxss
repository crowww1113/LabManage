/* 用户卡片 */
.user-card {
  margin: 24rpx 32rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
}

.user-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e8f0fe, #d4e4ff);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1c1c1e;
}

.user-role {
  font-size: 24rpx;
  color: #007aff;
  background-color: rgba(0, 122, 255, 0.08);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  align-self: flex-start;
}

/* 我的预约 */
.res-section {
  padding: 0 32rpx;
  margin-bottom: 20rpx;
}

.res-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #8e8e93;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  padding: 0 4rpx 16rpx;
  display: block;
}

.res-loading {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}

.res-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #e5e5ea;
  border-top: 4rpx solid #007aff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.res-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 12rpx;
}

.res-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.res-room {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.res-status {
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 12rpx;
}

.res-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.res-line {
  font-size: 26rpx;
  color: #8e8e93;
}

.res-remark {
  font-size: 24rpx;
  color: #c7c7cc;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 0.5rpx solid rgba(60, 60, 67, 0.08);
}

.res-empty {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}

.res-empty-text {
  font-size: 28rpx;
  color: #c7c7cc;
}

/* 菜单 */
.menu-section {
  padding: 0 32rpx;
  margin-bottom: 40rpx;
}

.menu-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 0 28rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
}

.menu-text {
  font-size: 30rpx;
  color: #1c1c1e;
}

.menu-arrow {
  font-size: 36rpx;
  color: #c7c7cc;
  font-weight: 300;
}

.menu-divider {
  height: 0.5rpx;
  background-color: rgba(60, 60, 67, 0.12);
}

/* 退出按钮 */
.logout-section {
  padding: 0 32rpx;
}

.logout-btn {
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background-color: #ffffff;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #ff3b30;
}
