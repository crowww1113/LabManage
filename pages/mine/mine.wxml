<!-- 用户信息卡片 -->
<view class="user-card">
  <view class="user-row">
    <view class="user-avatar">👤</view>
    <view class="user-info">
      <text class="user-name">{{realName || username}}</text>
      <text class="user-role">{{roleName}}</text>
    </view>
  </view>
</view>

<!-- 我的预约 -->
<view class="res-section">
  <text class="res-title">我的预约</text>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="res-loading">
    <view class="res-spinner"></view>
  </view>

  <!-- 预约列表 -->
  <view wx:elif="{{reservations.length > 0}}">
    <view wx:for="{{reservations}}" wx:key="id" class="res-card">
      <view class="res-top">
        <text class="res-room">{{item.roomNumber}}</text>
        <view class="res-status" style="color: {{statusMap[item.status].color}}; background-color: {{statusMap[item.status].color}}1a">
          {{statusMap[item.status].text}}
        </view>
      </view>
      <view class="res-info">
        <text class="res-line">📅 {{item.useDate}}</text>
        <text class="res-line">🕐 {{item.startTime}} - {{item.endTime}}</text>
        <text class="res-line">👥 {{item.studentCount}}人 · {{item.experimentContent}}</text>
      </view>
      <text wx:if="{{item.remark}}" class="res-remark">备注：{{item.remark}}</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:else class="res-empty">
    <text class="res-empty-text">暂无预约记录</text>
  </view>
</view>

<!-- 功能列表 -->
<view class="menu-section">
  <view class="menu-card">
    <view class="menu-item">
      <text class="menu-text">关于我们</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item">
      <text class="menu-text">意见反馈</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item">
      <text class="menu-text">服务条款</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>

<!-- 退出登录 -->
<view class="logout-section">
  <view class="logout-btn" bindtap="handleLogout">退出登录</view>
</view>
