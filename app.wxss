/* ========== 全局样式 - Apple 极简风 ========== */

page {
  background-color: #f2f2f7;
  font-size: 28rpx;
  color: #1c1c1e;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* 主按钮 - 蓝色强调 */
.btn-primary {
  display: block;
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background-color: #007aff;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  border-radius: 20rpx;
  border: none;
  letter-spacing: 2rpx;
}

.btn-primary::after {
  border: none;
}

/* 卡片 - 极简无阴影 */
.card-item {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}

/* 容器 */
.container {
  padding: 0 32rpx;
}

/* 文本溢出省略 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Flex 布局工具 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-1 {
  flex: 1;
}

/* ========== 色彩变量（通过 class 复用） ========== */
/* 主文本: #1c1c1e */
/* 次文本: #8e8e93 */
/* 分割线: rgba(60,60,67,0.12) */
/* 背景: #f2f2f7 */
/* 卡片: #ffffff */
/* 强调: #000000（纯黑） */
/* 链接/可交互: #007aff */
